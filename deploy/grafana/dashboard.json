{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" },
    { "name": "DS_LOKI",       "label": "Loki",       "type": "datasource", "pluginId": "loki" }
  ],
  "title": "Agentic Autoscaler — Decision Audit",
  "uid":   "agentic-autoscaler-decisions",
  "tags":  ["agentic-autoscaler", "autoscaling", "decisions"],
  "description": "Every scale decision the operator made: why, when, with what confidence, and which log patterns triggered it.",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },

  "templating": {
    "list": [
      {
        "name": "deployment", "label": "Deployment",
        "type": "query", "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(agentic_autoscaler_decisions_total, deployment)",
        "includeAll": true, "allValue": ".*", "multi": false, "refresh": 2
      }
    ]
  },

  "annotations": {
    "list": [
      {
        "name": "Scale events",
        "datasource": "${DS_LOKI}",
        "enable": true,
        "iconColor": "#6c8fff",
        "expr": "{app=\"agentic-autoscaler\"} | json | action=~\"scale-up|scale-down\"",
        "titleFormat": "{{action}} — {{deployment}}",
        "textFormat": "{{oldReplicas}} → {{newReplicas}} | {{reason}}"
      }
    ]
  },

  "panels": [

    {
      "id": 1, "type": "stat", "title": "Total Decisions (24 h)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"green","value":null}] } } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "sum(increase(agentic_autoscaler_decisions_total{deployment=~\"$deployment\"}[24h]))",
        "legendFormat": "decisions"
      }]
    },

    {
      "id": 2, "type": "stat", "title": "Scale-Ups (24 h)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#34d399", "mode": "fixed" } } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "sum(increase(agentic_autoscaler_decisions_total{action=\"scale-up\",deployment=~\"$deployment\"}[24h]))"
      }]
    },

    {
      "id": 3, "type": "stat", "title": "Scale-Downs (24 h)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#60a5fa", "mode": "fixed" } } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "sum(increase(agentic_autoscaler_decisions_total{action=\"scale-down\",deployment=~\"$deployment\"}[24h]))"
      }]
    },

    {
      "id": 4, "type": "stat", "title": "AI Provider Errors (24 h)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": {
        "thresholds": { "steps": [{"color":"green","value":null},{"color":"red","value":1}] },
        "color": { "mode": "thresholds" }
      }},
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "sum(increase(agentic_autoscaler_ai_provider_errors_total[24h])) or vector(0)"
      }]
    },

    {
      "id": 5, "type": "timeseries", "title": "Decisions Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 9 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "scale-up" },   "properties": [{"id":"color","value":{"fixedColor":"#34d399","mode":"fixed"}}] },
          { "matcher": { "id": "byName", "options": "scale-down" }, "properties": [{"id":"color","value":{"fixedColor":"#60a5fa","mode":"fixed"}}] },
          { "matcher": { "id": "byName", "options": "hold" },       "properties": [{"id":"color","value":{"fixedColor":"#4b5563","mode":"fixed"}}] }
        ]
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by(action)(increase(agentic_autoscaler_decisions_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    },

    {
      "id": 6, "type": "timeseries", "title": "Decision Latency (p50 / p95 / p99)",
      "description": "Time from signal collection start to policy-enforced decision.",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "datasource": "${DS_PROMETHEUS}", "expr": "histogram_quantile(0.50, sum(rate(agentic_autoscaler_decision_latency_seconds_bucket{deployment=~\"$deployment\"}[5m])) by (le))", "legendFormat": "p50" },
        { "datasource": "${DS_PROMETHEUS}", "expr": "histogram_quantile(0.95, sum(rate(agentic_autoscaler_decision_latency_seconds_bucket{deployment=~\"$deployment\"}[5m])) by (le))", "legendFormat": "p95" },
        { "datasource": "${DS_PROMETHEUS}", "expr": "histogram_quantile(0.99, sum(rate(agentic_autoscaler_decision_latency_seconds_bucket{deployment=~\"$deployment\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },

    {
      "id": 7, "type": "table", "title": "Decision Audit Log (via Loki)",
      "description": "Every scale decision. Click a row for the full reason. Filter by deployment using the variable above.",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 12 },
      "options": {
        "sortBy": [{ "displayName": "timestamp", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "overrides": [
          { "matcher": {"id":"byName","options":"action"},     "properties": [{"id":"custom.width","value":90},  {"id":"mappings","value":[
              {"type":"value","options":{"scale-up":  {"text":"↑ scale-up",  "color":"green"}, "scale-down":{"text":"↓ scale-down","color":"blue"}, "hold":{"text":"— hold","color":"text"}}}
            ]}]},
          { "matcher": {"id":"byName","options":"confidence"}, "properties": [{"id":"custom.width","value":90},  {"id":"unit","value":"percentunit"}]},
          { "matcher": {"id":"byName","options":"timestamp"},  "properties": [{"id":"custom.width","value":160}]},
          { "matcher": {"id":"byName","options":"reason"},     "properties": [{"id":"custom.width","value":400}]},
          { "matcher": {"id":"byName","options":"dryRun"},     "properties": [{"id":"custom.width","value":70}]}
        ]
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        { "id": "organize", "options": {
            "renameByName": { "timestamp":"Time", "deployment":"Deployment", "action":"Action", "oldReplicas":"Old", "newReplicas":"New", "reason":"Reason", "confidence":"Confidence", "provider":"Provider", "dryRun":"Dry Run" },
            "indexByName": { "Time":0, "Deployment":1, "Action":2, "Old":3, "New":4, "Reason":5, "Confidence":6, "Provider":7, "Dry Run":8 }
        }}
      ],
      "targets": [{
        "datasource": "${DS_LOKI}",
        "expr": "{app=\"agentic-autoscaler\", namespace=~\".+\"} | json | deployment=~\"$deployment\" | line_format \"{{.timestamp}}\t{{.deployment}}\t{{.action}}\t{{.oldReplicas}}\t{{.newReplicas}}\t{{.reason}}\t{{.confidence}}\t{{.provider}}\t{{.dryRun}}\"",
        "queryType": "range",
        "legendFormat": ""
      }]
    },

    {
      "id": 8, "type": "barchart", "title": "Pattern Frequency (24 h)",
      "description": "Which log patterns triggered the most decisions. Patterns firing >42× per week may be noise.",
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 9 },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "hidden" } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#6c8fff", "mode": "fixed" } } },
      "targets": [{
        "datasource": "${DS_LOKI}",
        "expr": "sum by(patterns) ({app=\"agentic-autoscaler\"} | json | patterns != \"\" | action=~\"scale-up|scale-down\")",
        "queryType": "range",
        "legendFormat": "{{patterns}}"
      }]
    },

    {
      "id": 9, "type": "histogram", "title": "Confidence Distribution",
      "description": "Decisions with confidence < 0.5 are worth reviewing manually.",
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 9 },
      "options": { "fillOpacity": 60, "legendDisplayMode": "hidden" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#fbbf24", "mode": "fixed" }, "unit": "percentunit" } },
      "targets": [{
        "datasource": "${DS_LOKI}",
        "expr": "{app=\"agentic-autoscaler\"} | json | confidence != \"\" | unwrap confidence | __error__=\"\"",
        "queryType": "range",
        "legendFormat": "confidence"
      }]
    }

  ]
}
