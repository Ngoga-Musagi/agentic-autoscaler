# agentic-autoscaler — local run configuration TEMPLATE.
# Copy this to `.env` and fill in real values. `.env` is git-ignored; this
# template is safe to commit. These map 1:1 to the env vars the operator reads
# (see pkg/reasoning/agent.go NewAgentFromEnv, pkg/observability).

# ---- AI reasoning backend -------------------------------------------------
# One of: rules | anthropic | openai | ollama
AI_PROVIDER=rules

# Anthropic — used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# The code default (claude-sonnet-4-20250514) may be retired; set a current id.
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama — used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ---- Operator runtime -----------------------------------------------------
# Namespace the decision-audit ConfigMap is written to.
OPERATOR_NAMESPACE=default

# ---- Grafana annotations (optional) ---------------------------------------
# Leave GRAFANA_URL empty to disable annotation push.
GRAFANA_URL=
GRAFANA_API_KEY=
GRAFANA_DASHBOARD_UID=
